# Public client config — safe to ship in the app bundle. Never put service keys here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# For a physical device: http://<your-LAN-IP>:8000/api/v1 — localhost only works for emulators/web.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
