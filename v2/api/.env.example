# ── Supabase ────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=public-anon-key
# Service-role key: SERVER-SIDE ONLY. Never expose to the web client.
SUPABASE_SERVICE_ROLE_KEY=service-role-key
# Legacy HS256 projects: paste JWT secret (Settings → API → JWT Secret).
# Newer asymmetric-key projects can leave this blank — JWKS is fetched from
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json automatically.
SUPABASE_JWT_SECRET=

# ── Postgres (direct, used by SQLModel) ────────────────────────────────
# Supabase pooler URL — Settings → Database → Connection string (pooler).
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── App ────────────────────────────────────────────────────────────────
# The web client's origin — the ONLY allowed CORS origin.
WEB_ORIGIN=http://localhost:5173
STORAGE_BUCKET=journal
SIGNED_URL_TTL_SECONDS=900
ORG_TIMEZONE=Asia/Manila
ENV=dev
# Used for links inside notification emails.
APP_BASE_URL=http://localhost:5173

# ── Email (assignment notifications) — Maileroo SMTP ───────────────────
# Leave SMTP_USER/SMTP_PASSWORD empty to disable sending (dev default).
SMTP_HOST=smtp.maileroo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Verified sender, e.g. "CounciLog <no-reply@yourdomain.com>"
MAIL_FROM=
